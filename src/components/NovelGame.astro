---
import { prompts } from '../lib/novel-game.mjs';
---
<section class="novel" aria-label="互动文字小说">
  <nav><a href="/playground/">← 基础 Playground</a><span>玩法空间 / 01</span></nav>
  <p>Jev 负责判断情绪与好感变化，程序决定状态，角色只说预先写好的台词。</p>
  <div class="novel-grid">
    <div>
      <label for="novel-mode">运行方式</label><select id="novel-mode"><option value="mock">规则演示 · 不调用 API</option><option value="live">真实 Jev · 每回合 2 次请求</option></select>
      <div id="novel-auth" hidden><label for="novel-key">你的 API Key</label><input id="novel-key" type="password" autocomplete="off" placeholder="仅本页使用，不保存" /><p class="hint">经本站 Cloudflare 转发给官方；不记录内容。每回合并发调用 Choice 与 Score，可能计费，无自动重试。</p></div>
      <div class="character"><span class="avatar" aria-hidden="true">✿</span><h2>小夏 <span id="novel-stage">初见</span></h2><p>傲娇青梅竹马 · 放学后的街角</p><label for="novel-favor">好感度 <strong id="novel-favor-label">35 / 100</strong></label><progress id="novel-favor" max="100" value="35"></progress></div>
      <p id="novel-decision">尚未结算回合</p><p id="novel-timing" class="hint">规则演示不代表模型判断或性能。</p>
      <details><summary>状态机规则</summary><p>好感度 0–49：初见；50–79：熟悉；80–100：告白节点。下降时阶段随之回退；到达告白节点后可手动进入终章。</p><p>Score 使用 5 个有序档位，返回的 0–4 加权分通过 round(score × 5 − 10) 映射到 −10～+10；好感度限制在 0～100。台词按回合顺序从情绪对应剧本轮换。</p></details>
      <button id="novel-finish" type="button" disabled>进入终章</button><button id="novel-reset" type="button">重新开始</button>
    </div>
    <div>
      <div id="novel-history" role="log" aria-label="对话记录" aria-live="polite"><p>小夏：“才没有在等你呢……今天有什么想说的？”</p></div>
      <form id="novel-form"><label for="novel-input">你想对她说什么？</label><textarea id="novel-input" rows="3" maxlength="1000" required></textarea><div class="quick">{prompts.map(prompt => <button type="button" data-novel-prompt={prompt}>{prompt}</button>)}</div><button id="novel-send" type="submit">推进一回合</button><button id="novel-cancel" type="button" disabled>取消等待</button></form>
      <p id="novel-status" role="status">当前为规则演示，不会发送请求。快捷语句只填入，不自动运行。</p>
    </div>
  </div>
</section>
<script>
import { initialState, novelPayloads, settleTurn, mockDecision } from '../lib/novel-game.mjs';
import { requestDecision, redact } from '../lib/playground.mjs';
const el = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
const mode=el<HTMLSelectElement>('novel-mode'), key=el<HTMLInputElement>('novel-key'), input=el<HTMLTextAreaElement>('novel-input');
const status=el('novel-status'), history=el('novel-history');
let state=initialState(); let active:AbortController|undefined;
function panel(){el('novel-stage').textContent=state.stage;el('novel-favor-label').textContent=`${state.favor} / 100`;el<HTMLProgressElement>('novel-favor').value=state.favor;el<HTMLButtonElement>('novel-finish').disabled=!!active||state.stage!=='告白节点';el<HTMLButtonElement>('novel-send').disabled=!!active||state.stage==='终章';}
function addLine(text:string){const p=document.createElement('p');p.textContent=text;history.append(p);history.scrollTop=history.scrollHeight;}
function busy(value:boolean){for(const id of ['novel-mode','novel-reset','novel-input','novel-key']) (el(id) as HTMLInputElement).disabled=value;document.querySelectorAll<HTMLButtonElement>('[data-novel-prompt]').forEach(b=>b.disabled=value);el<HTMLButtonElement>('novel-cancel').disabled=!value;panel();}
function reset(){state=initialState();history.replaceChildren();addLine('小夏：“才没有在等你呢……今天有什么想说的？”');el('novel-decision').textContent='尚未结算回合';el('novel-timing').textContent=mode.value==='mock'?'规则演示不代表模型判断或性能。':'显示两次请求并发完成的总耗时，包含网络时间。';input.value='';panel();}
mode.addEventListener('change',()=>{key.value='';el('novel-auth').hidden=mode.value!=='live';reset();status.textContent=mode.value==='live'?'真实模式：每回合 2 次请求；模型结果不保证与示例预期相同。':'规则演示：不调用 API。';});
el('novel-reset').addEventListener('click',()=>{reset();status.textContent='故事已重新开始。';});
document.querySelectorAll<HTMLButtonElement>('[data-novel-prompt]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.novelPrompt!;input.focus();}));
el('novel-cancel').addEventListener('click',()=>active?.abort());
el('novel-finish').addEventListener('click',()=>{if(active||state.stage!=='告白节点')return;state={...state,stage:'终章'};addLine('终章 · 小夏：“明天也一起走吧。这次……是我在等你。”');status.textContent='故事结束，可以重新开始。';panel();});
el<HTMLFormElement>('novel-form').addEventListener('submit',async event=>{
 event.preventDefault();if(active||state.stage==='终章')return;
 const text=input.value.trim(), secret=key.value.trim(), live=mode.value==='live';let payloads;
 try{payloads=novelPayloads(state,text);if(live&&!secret)throw Error('请填写自己的 API Key。');}catch(e){status.textContent=(e as Error).message;return;}
 const controller=new AbortController();active=controller;busy(true);status.textContent=live?'正在并发判断情绪和好感…':'正在结算规则演示…';const start=performance.now();const timer=setTimeout(()=>controller.abort(),30000);
 try{
  const answers=live?await Promise.all(payloads.map(async payload=>(await requestDecision({key:secret,payload,signal:controller.signal,endpoint:'/api/systemone'})).answers.result)):mockDecision(text);
  if(controller.signal.aborted)return;
  const result=settleTurn(state,answers[0],answers[1]);state=result.state;
  addLine(`你：${redact(text,secret)}`);addLine(`小夏：${result.line}`);
  el('novel-decision').textContent=`${live?'Jev':'规则演示'} · Choice('${result.emotion}') · 好感变化 ${result.delta>=0?'+':''}${result.delta}（实际 ${result.appliedDelta>=0?'+':''}${result.appliedDelta}）`;
  el('novel-timing').textContent=live?`并发请求总耗时 ${Math.round(performance.now()-start)} ms · 含网络与转发时间`:'规则演示结果 · 未调用模型';input.value='';status.textContent='本回合已结算。';
 }catch(e){controller.abort();status.textContent=`本回合未结算：${redact((e as Error).message,secret)}。真实请求可能已产生费用。`;}
 finally{clearTimeout(timer);active=undefined;busy(false);}
});
window.addEventListener('pagehide',()=>{active?.abort();key.value='';});
</script>
<style>
.novel nav{display:flex;justify-content:space-between;gap:1rem}.novel-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:2rem;margin-top:2rem}.novel-grid>div{min-width:0}.novel label{display:block;margin:.8rem 0 .4rem}.novel input,.novel select,.novel textarea{width:100%;padding:.7rem;background:var(--sl-color-bg);color:var(--sl-color-text);border:1px solid var(--sl-color-gray-5);border-radius:.4rem;font:inherit}.novel button{padding:.6rem .8rem;margin:.5rem .5rem 0 0;background:var(--sl-color-bg-nav);color:var(--sl-color-text);border:1px solid var(--sl-color-gray-5);border-radius:.4rem;cursor:pointer}.novel button:disabled{opacity:.45;cursor:default}.character{padding:1.5rem;margin:1rem 0;border:1px solid var(--sl-color-gray-5);border-radius:.8rem;background:var(--sl-color-bg-nav)}.avatar{font-size:3rem;color:var(--cn-accent)}#novel-stage{font-size:.8rem;padding:.3rem .6rem;border:1px solid var(--cn-accent);border-radius:1rem}progress{width:100%;accent-color:var(--cn-accent)}.hint,.quick button{font-size:.8rem;color:var(--sl-color-gray-2)}#novel-history{height:22rem;overflow:auto;padding:1rem;border:1px solid var(--sl-color-gray-5);border-radius:.8rem;background:var(--sl-color-bg-nav);overflow-wrap:anywhere}#novel-send{background:var(--cn-accent);color:var(--cn-on-accent)}[hidden]{display:none!important}@media(max-width:50rem){.novel-grid{grid-template-columns:1fr}#novel-history{height:18rem}}
</style>
