---
import { examples } from '../lib/playground-examples.mjs';
---
<section class="pg" aria-label="Jev Playground">
  <p class="pg-help">自带 API Key · 经本站 Cloudflare 转发给官方，不保存 Key 或记录请求内容 · 手动运行可能产生费用</p>
  <div class="pg-workspace"><form id="pg-form">
    <fieldset><legend>1 / 连接设置</legend>
      <label for="pg-key">你的 TypeSafe API Key</label>
      <div class="pg-key-row"><input id="pg-key" type="password" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="输入你自己的 Key" /><button id="pg-clear" type="button">清除 Key</button></div>
      <label class="pg-check"><input id="pg-remember" type="checkbox" />在此浏览器记住 Key</label>
      <p class="pg-help">仅在可信设备保存；同源脚本可读取。取消勾选即删除。</p>
      <p id="pg-storage" role="status">未保存 Key；只在本页使用。</p>
      <details><summary>模型设置</summary><label for="pg-model">模型</label><input id="pg-model" value="jev-latest" maxlength="100" spellcheck="false" /></details>
    </fieldset>
    <fieldset id="pg-editors"><legend>2 / 设计一次判断</legend>
      <label for="pg-type">问题类型</label><select id="pg-type"><option value="choice">Choice · 有限选项</option><option value="noul">Noul · 是非概率</option><option value="score">Score · 有序评分</option></select>

      <label for="pg-state">输入状态</label><textarea id="pg-state" rows="4" maxlength="20000"></textarea>
      <label for="pg-instructions">要判断的问题</label><textarea id="pg-instructions" rows="3" maxlength="5000"></textarea>
      <label for="pg-criteria">选项 / 评价标准（JSON）</label><textarea id="pg-criteria" rows="8" maxlength="20000" spellcheck="false"></textarea>
      <p id="pg-criteria-help" class="pg-help">Choice 使用“选项名称 → 描述”的对象。</p>
    </fieldset>
    <div class="pg-actions"><button id="pg-run" type="submit">运行 1 次请求</button><button id="pg-cancel" type="button" disabled>取消等待</button><button id="pg-preview" type="button">预览请求（不发送）</button></div>
  </form>
  <div class="pg-results">
  <p id="pg-status" role="status" aria-live="polite">准备就绪。请填写自己的 Key，再手动运行。</p>
  <section aria-labelledby="pg-output-title"><h2 id="pg-output-title">判断结果</h2><p id="pg-summary" class="pg-help">运行后显示概率分布与耗时。</p><div id="pg-visual" aria-live="polite"><p>选一个示例，看看模型如何判断。</p></div><details id="pg-raw"><summary id="pg-raw-label">原始 JSON</summary><pre class="pg-output" tabindex="0"><code id="pg-output">等待运行或预览请求。</code></pre><button id="pg-download" type="button" disabled>下载结果 JSON</button></details></section>
  <details class="pg-library" id="pg-library"><summary>选择中文示例 · 9 个场景</summary>

    <p class="pg-help">9 个中文原创场景。点击卡片替换编辑区，不会自动运行；也没有预填模型答案。</p>
    <div class="pg-filters" role="group" aria-label="筛选示例类型">
      <button type="button" data-example-filter="all" aria-pressed="true">全部</button>
      <button type="button" data-example-filter="choice" aria-pressed="false">Choice</button>
      <button type="button" data-example-filter="noul" aria-pressed="false">Noul</button>
      <button type="button" data-example-filter="score" aria-pressed="false">Score</button>
    </div>
    <div class="pg-example-groups">
      {['趣味判断', '开发实践'].map(group => <section data-example-group><h3>{group}</h3><div class="pg-example-grid">{examples.filter(item => item.group === group).map(item => <button type="button" class="pg-example-card" data-example-id={item.id} data-example-type={item.type} aria-pressed="false"><span class="pg-card-top"><span class="pg-card-icon" aria-hidden="true">{item.icon}</span><span class="pg-card-type">{item.type}</span></span><strong>{item.title}</strong><span>{item.description}</span></button>)}</div></section>)}
    </div>
    <aside class="pg-experiment-tip" aria-live="polite"><strong id="pg-example-title">当前示例：中文提问该交给谁？</strong><p id="pg-example-tip">试试否定、中英混写或多个诉求。</p></aside>
  </details>
  </div></div>
  <noscript>Playground 需要 JavaScript；文档与公开实践仍可正常阅读。</noscript>
</section>
<script>
import { examples } from '../lib/playground-examples.mjs';
import { renderResult } from '../lib/playground-result.mjs';
import { makePayload, requestDecision, redact, STORAGE_KEY } from '../lib/playground.mjs';
const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
const key = el<HTMLInputElement>('pg-key');
const remember = el<HTMLInputElement>('pg-remember');
const storage = el('pg-storage');
const type = el<HTMLSelectElement>('pg-type');
const state = el<HTMLTextAreaElement>('pg-state');
const instructions = el<HTMLTextAreaElement>('pg-instructions');
const criteria = el<HTMLTextAreaElement>('pg-criteria');
const status = el('pg-status');
const output = el('pg-output');
const summary = el('pg-summary');
const run = el<HTMLButtonElement>('pg-run');
const cancel = el<HTMLButtonElement>('pg-cancel');
const download = el<HTMLButtonElement>('pg-download');
let controller: AbortController | undefined;
let exportText = '';
function saveKey() {
  try {
    if (remember.checked && key.value.trim()) {
      localStorage.setItem(STORAGE_KEY, key.value.trim());
      storage.textContent = 'Key 已保存在此浏览器。可随时清除。';
    } else {
      localStorage.removeItem(STORAGE_KEY);
      storage.textContent = '未保存 Key；只在本页使用。';
    }
  } catch { remember.checked = false; storage.textContent = '浏览器拒绝访问本地存储；请检查浏览器的网站数据设置。当前 Key 仍可在本页使用。'; }
}
try {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) { key.value = saved; remember.checked = true; storage.textContent = '已从此浏览器恢复 Key。'; }
} catch { storage.textContent = '本地存储不可用，Key 仅在本页使用。'; }
remember.addEventListener('change', saveKey);
key.addEventListener('input', saveKey);
function clearResult() { exportText = ''; download.disabled = true; output.textContent = '等待运行或预览请求。'; summary.textContent = '运行后显示概率分布与耗时。'; el('pg-visual').textContent = '等待运行，尚无模型结果。'; el<HTMLDetailsElement>('pg-raw').open = false; el('pg-raw-label').textContent = '原始 JSON'; }
el('pg-clear').addEventListener('click', () => { controller?.abort(); key.value = ''; remember.checked = false; saveKey(); clearResult(); status.textContent = 'Key 已从输入框清除；本地存储状态见上方提示。'; });
function help() { el('pg-criteria-help').textContent = ({ choice: 'Choice 使用“选项名称 → 描述”的对象。', noul: 'Noul 使用 true / false 字段描述两种结果。', score: 'Score 使用从低到高排列的数组，档位从 0 开始。' })[type.value]!; }
const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-example-id]'));
function loadExample(id: string) {
  if (controller) return;
  const value = examples.find(item => item.id === id);
  if (!value) return;
  type.value = value.type; state.value = value.state; instructions.value = value.instructions;
  criteria.value = JSON.stringify(value.criteria, null, 2); help(); clearResult();
  cards.forEach(card => card.setAttribute('aria-pressed', String(card.dataset.exampleId === id)));
  el('pg-example-title').textContent = `当前示例：${value.title}`;
  el('pg-example-tip').textContent = value.tip;
  el<HTMLDetailsElement>('pg-library').open = false;
  status.textContent = `已载入“${value.title}”，未发送请求。可以修改输入或预览请求。`;
}
loadExample('routing');
type.addEventListener('change', help);

cards.forEach(card => card.addEventListener('click', () => loadExample(card.dataset.exampleId!)));
document.querySelectorAll<HTMLButtonElement>('[data-example-filter]').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('[data-example-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
  cards.forEach(card => { card.hidden = button.dataset.exampleFilter !== 'all' && card.dataset.exampleType !== button.dataset.exampleFilter; });
  document.querySelectorAll<HTMLElement>('[data-example-group]').forEach(group => { group.hidden = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-example-id]')).every(card => card.hidden); });
}));
[state, instructions, criteria, type].forEach(input => input.addEventListener('input', () => {
  cards.forEach(card => card.setAttribute('aria-pressed', 'false'));
  el('pg-example-title').textContent = '已修改 · 自定义试验'; clearResult(); status.textContent = '输入已修改，请重新运行。';
}));
function payload() { return makePayload({ type: type.value, model: el<HTMLInputElement>('pg-model').value, state: state.value, instructions: instructions.value, criteria: criteria.value }); }
el('pg-preview').addEventListener('click', () => {
  try { const body = payload(); clearResult(); output.textContent = redact(JSON.stringify(body, null, 2), key.value.trim()); el<HTMLDetailsElement>('pg-raw').open = true; el('pg-raw-label').textContent = '请求预览（未发送）'; status.textContent = '仅预览请求体，没有发送网络请求。'; }
  catch (error) { status.textContent = redact((error as Error).message, key.value.trim()); }
});
el<HTMLFormElement>('pg-form').addEventListener('submit', async event => {
  event.preventDefault(); if (controller) return;
  let body; try { body = payload(); if (!key.value.trim()) throw new Error('请先填写自己的 API Key。'); } catch (error) { status.textContent = (error as Error).message; return; }
  const secret = key.value.trim();
  saveKey(); clearResult(); controller = new AbortController();
  const active = controller; let timedOut = false;
  const timer = setTimeout(() => { timedOut = true; active.abort(); }, 30000);
  run.disabled = true; cancel.disabled = false; cards.forEach(card => { card.disabled = true; });
  el<HTMLFieldSetElement>('pg-editors').disabled = true; el<HTMLButtonElement>('pg-preview').disabled = true;
  status.textContent = '正在通过 Cloudflare Worker 请求官方 API…'; const start = performance.now();
  try {
    const data = await requestDecision({ key: secret, payload: body, signal: active.signal, endpoint: '/api/systemone' });
    if (active.signal.aborted) return;
    const elapsedMs = Math.round(performance.now() - start);
    exportText = redact(JSON.stringify({ capturedAt: new Date().toISOString(), elapsedMs, request: body, response: data }, null, 2), secret);
    const safeData = JSON.parse(redact(JSON.stringify(data), secret));
    renderResult(el('pg-visual'), safeData.answers.result);
    output.textContent = JSON.stringify(safeData, null, 2);
    summary.textContent = redact(`实际模型：${String(data.model ?? '未返回')} · 请求总耗时：${elapsedMs} ms`, secret);
    download.disabled = false; status.textContent = '请求完成。结果来自真实 API 返回。';
  } catch (error) {
    status.textContent = active.signal.aborted ? (timedOut ? '等待超过 30 秒，已停止等待；服务端可能仍已处理并计费。' : '已取消等待；服务端可能仍已处理并计费。') : error instanceof TypeError ? '无法连接线上接口，请检查网络或稍后手动重试。' : redact((error as Error).message, secret);
  } finally {
    clearTimeout(timer); controller = undefined; run.disabled = false; cancel.disabled = true; cards.forEach(card => { card.disabled = false; });
    el<HTMLFieldSetElement>('pg-editors').disabled = false; el<HTMLButtonElement>('pg-preview').disabled = false;
  }
});
cancel.addEventListener('click', () => controller?.abort());
download.addEventListener('click', () => {
  if (!exportText) return;
  const url = URL.createObjectURL(new Blob([exportText], { type: 'application/json' }));
  const link = document.createElement('a'); link.href = url; link.download = 'jevcn-playground-result.json'; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
});
window.addEventListener('pagehide', () => { controller?.abort(); key.value = ''; clearResult(); });
window.addEventListener('pageshow', event => { if (event.persisted) { try { key.value = localStorage.getItem(STORAGE_KEY) ?? ''; remember.checked = Boolean(key.value); } catch { key.value = ''; } } });
</script>
<style>
.pg { --pg-border: var(--sl-color-gray-5); }
.pg-notice { border-left: 3px solid var(--sl-color-accent); background: var(--sl-color-bg-nav); padding: 1rem 1.25rem; font-size: .9rem; }
.pg-notice p { margin-top: .5rem; }
.pg fieldset { border: 1px solid var(--pg-border); border-radius: .5rem; padding: 1.25rem; margin: 1.5rem 0; min-width: 0; }
.pg legend { padding: 0 .5rem; font-weight: 700; }
.pg label { display: block; margin: 1rem 0 .4rem; font-weight: 600; }
.pg input:not([type=checkbox]),.pg textarea,.pg select { box-sizing: border-box; width: 100%; border: 1px solid var(--pg-border); border-radius: .3rem; background: var(--sl-color-bg); color: var(--sl-color-text); padding: .7rem; font: inherit; }
.pg textarea { resize: vertical; font-family: var(--sl-font-mono); font-size: .88rem; }
.pg .pg-check { display: flex; align-items: center; gap: .6rem; }
.pg-help,#pg-storage { font-size: .8rem; color: var(--sl-color-gray-2); }
.pg button { border: 1px solid var(--pg-border); border-radius: .3rem; padding: .65rem .9rem; background: var(--sl-color-bg-nav); color: var(--sl-color-text); font: inherit; cursor: pointer; }
.pg button:disabled { opacity: .5; cursor: not-allowed; }
.pg-key-row,.pg-actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
.pg-key-row input { flex: 1; min-width: 150px; }
.pg-key-row > *, .pg-actions > * { margin: 0 !important; }
#pg-run { background: var(--cn-accent); color: var(--cn-on-accent); }
#pg-example { margin-top: 1rem; }
.pg-output { max-height: 32rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .85rem; }
#pg-status { border-block: 1px solid var(--pg-border); padding-block: 1rem; }

.pg-workspace { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); gap: 2rem; align-items: start; }
.pg-workspace > * { min-width: 0; }
.pg-results { position: static; border: 1px solid var(--pg-border); border-radius: .5rem; padding: 1.25rem; margin-top: 1.5rem; background: var(--sl-color-bg-nav); }
.pg-results h2 { font-size: 1.4rem; }
.pg-results .pg-output { min-height: 16rem; background: var(--sl-color-bg); }
@media(max-width: 50rem) { .pg-workspace { grid-template-columns: 1fr; gap: 0; } .pg-results { position: static; } }

.pg-library > h2 { margin-top: 0; }
.pg-filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; }
.pg-filters button { padding: .35rem .65rem; font-size: .8rem; margin: 0; }
.pg-filters button[aria-pressed=true] { background: var(--cn-accent); color: var(--cn-on-accent); }
.pg-example-groups { max-height: 36rem; overflow-y: auto; padding: .3rem; }
.pg-example-groups h3 { font-size: .95rem; margin: .8rem 0; }
.pg-example-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; }
.pg .pg-example-card { display: flex; flex-direction: column; text-align: left; gap: .45rem; padding: .85rem; margin: 0; background: var(--sl-color-bg); }
.pg .pg-example-card[hidden], .pg [data-example-group][hidden] { display: none; }
.pg-example-card:hover, .pg-example-card[aria-pressed=true] { border-color: var(--cn-accent); }
.pg-example-card[aria-pressed=true] { box-shadow: inset 0 0 0 1px var(--cn-accent); }
.pg-card-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.pg-card-icon { font-size: 1.9rem; line-height: 1.3; }
.pg-card-type { font-size: .7rem; color: var(--cn-accent); text-transform: uppercase; font-family: var(--sl-font-mono); }
.pg-example-card strong { font-size: .9rem; }
.pg-example-card > span:last-child { color: var(--sl-color-gray-2); font-size: .75rem; line-height: 1.7; }
.pg-experiment-tip { border-left: 2px solid var(--cn-accent); padding: .6rem .8rem; margin-top: 1rem; font-size: .85rem; }
.pg-experiment-tip p { margin-top: .4rem; color: var(--sl-color-gray-2); }
@media(max-width:50rem) { .pg-example-groups { max-height: none; } }
@media(max-width:24rem) { .pg-example-grid { grid-template-columns: 1fr; } }

.pg details { border-top: 1px solid var(--pg-border); padding-top: .8rem; margin-top: 1rem; }
.pg summary { cursor: pointer; font-weight: 600; }
.pg-results { position: sticky; top: calc(var(--sl-nav-height) + 1rem); }
.pg-results .pg-output { min-height: 0; }
.pg :global(#pg-visual h3) { font-size: 1.8rem; color: var(--cn-accent); overflow-wrap: anywhere; margin: 1rem 0; }
.pg :global(.pg-probability) { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .35rem 1rem; margin: 1rem 0; }
.pg :global(.pg-probability span) { overflow-wrap: anywhere; }
.pg :global(.pg-probability strong) { font-variant-numeric: tabular-nums; }
.pg :global(.pg-probability progress) { grid-column: 1 / -1; width: 100%; height: .6rem; appearance: none; border: 0; border-radius: 1rem; overflow: hidden; background: var(--sl-color-gray-5); }
.pg :global(progress::-webkit-progress-bar) { background: var(--sl-color-gray-5); }
.pg :global(progress::-webkit-progress-value) { background: var(--cn-accent); }
.pg :global(progress::-moz-progress-bar) { background: var(--cn-accent); }
@media(max-width:50rem) { .pg-results { position: static; } }
</style>
