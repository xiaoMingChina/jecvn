---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
const playground = Astro.locals.starlightRoute.entry.id === 'playground' || Astro.locals.starlightRoute.entry.id === 'playground/index';
const home = Astro.locals.starlightRoute.id === '' || Astro.locals.starlightRoute.entry.id === 'index';
---
{playground ? (<section class="pg-workspace-heading"><p class="cn-kicker">JEV / 中文试验场</p><h1 id="_top" data-page-title>Playground</h1><p>编辑一个问题，观察一次决策。Choice · Noul · Score</p></section>) : home ? (
<section class="cn-hero" aria-labelledby="_top">
  <div class="cn-eyebrow"><span class="cn-dot"></span> JEV / 中文开发者社区 <span class="cn-edition">中文优先 · 面向全球生态</span></div>
  <div class="cn-hero-grid">
    <div class="cn-hero-copy">
      <p class="cn-kicker">小模型，大有可为。</p>
      <h1 id="_top" data-page-title>让 AI 决策，<br />成为代码的<span class="cn-highlight">直觉。</span></h1>
      <p class="cn-lead">用中文发现、理解和验证 Jev。<br />读全球项目，做本地实验，记录成功与失败，<br class="cn-desktop-break" />一起积累可以复查的开发经验。</p>
      <div class="cn-actions"><a class="cn-button cn-primary" href="/getting-started/introduction/">开始了解 Jev <span aria-hidden="true">↗</span></a><a class="cn-button cn-secondary" href="/labs/">探索 Labs <span aria-hidden="true">↗</span></a><a class="cn-text-link" href="https://github.com/xiaoMingChina/jevcn">GitHub ↗</a></div>
      <div class="cn-hero-note"><span>中文指南</span><span>开源共建</span><span>工程实践</span></div>
    </div>
    <div class="cn-lab" aria-label="决策示例工作台">
      <div class="cn-window-bar"><span><i></i><i></i><i></i></span><span>JEV / DECISION LAB</span><span aria-hidden="true">↗</span></div>
      <div class="cn-lab-body">
        <div class="cn-lab-label"><span>01 / 选择一个场景</span><span>本地演示</span></div>
        <div class="cn-scenarios" role="group" aria-label="切换决策示例">
          <button type="button" data-scenario="support" aria-pressed="true">客服分流</button><button type="button" data-scenario="review" aria-pressed="false">人工复核</button><button type="button" data-scenario="intent" aria-pressed="false">意向识别</button>
        </div>
        <div class="cn-input"><span class="cn-code-label">INPUT / 自然语言</span><p id="demo-input">“订单还没收到，能帮我查一下物流吗？”</p></div>
        <div class="cn-process"><span></span><b>Jev</b><span></span><em>类型约束 · 概率决策</em></div>
        <div class="cn-output" aria-live="polite" aria-atomic="true"><span class="cn-code-label">OUTPUT / 结构化决策</span><pre><code id="demo-output">{`{
  "route": "物流查询",
  "probability": 0.96
}`}</code></pre><div class="cn-result"><span class="cn-dot"></span><span id="demo-result">交给物流处理流程</span><span>Choice</span></div></div>
        <p class="cn-demo-note">示意数据，非实时 API 返回；实际决策需结合业务阈值。</p>
      </div>
    </div>
  </div>
  <div class="cn-bottomline"><span>面向软件的智能 / MACHINE-NATIVE INTELLIGENCE</span><a href="https://typesafe.ai/">认识 TypeSafe AI 官方项目 ↗</a></div>
</section>
) : <DefaultHero />}
<script>
const examples = {
  support: { input: '“订单还没收到，能帮我查一下物流吗？”', output: '{\n  "route": "物流查询",\n  "probability": 0.96\n}', result: '交给物流处理流程' },
  review: { input: '“申请退款，但订单信息与付款记录不一致。”', output: '{\n  "route": "人工复核",\n  "probability": 0.88\n}', result: '转交人工确认，保留业务控制权' },
  intent: { input: '“我们有 20 人的团队，想了解企业版接入。”', output: '{\n  "route": "企业咨询",\n  "probability": 0.94\n}', result: '交给企业服务流程' },
};
document.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(button => {
  button.addEventListener('click', () => {
    const example = examples[button.dataset.scenario as keyof typeof examples];
    if (!example) return;
    document.querySelectorAll('[data-scenario]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    document.getElementById('demo-input')!.textContent = example.input;
    document.getElementById('demo-output')!.textContent = example.output;
    document.getElementById('demo-result')!.textContent = example.result;
  });
});
</script>
