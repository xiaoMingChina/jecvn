{
  "name": "jevcn",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.js",
  "ratelimits": [
    {
      "name": "PLAYGROUND_RATE_LIMITER",
      "namespace_id": "92422001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
